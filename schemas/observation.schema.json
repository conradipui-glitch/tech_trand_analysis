{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tech-trend-analysis.local/schemas/observation.schema.json",
  "title": "Observation",
  "description": "Source-agnostic normalized evidence item produced by any provider adapter.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "provider",
    "evidence_type",
    "artifact_kind",
    "external_id",
    "title",
    "observed_at",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.2.0"
    },
    "observation_id": {
      "type": "string",
      "minLength": 3
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "description": "Stable provider identifier from source registry, e.g. github, openalex, epo_ops. Not enumerated so new sources do not require a core schema change."
    },
    "evidence_type": {
      "type": "string",
      "enum": [
        "research",
        "patent",
        "implementation",
        "product",
        "adoption",
        "investment",
        "regulation",
        "analysis",
        "other"
      ],
      "description": "Stable semantic taxonomy consumed by scoring. New providers should map into this taxonomy."
    },
    "artifact_kind": {
      "type": "string",
      "minLength": 1,
      "description": "Provider-normalized artifact label such as paper, patent, repository, model, dataset, report. Extensible without schema changes."
    },
    "external_id": {
      "type": "string",
      "minLength": 1
    },
    "canonical_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": [
        "string",
        "null"
      ],
      "description": "Compact abstract/description/snippet; do not require full source text."
    },
    "published_at": {
      "$ref": "#/$defs/source_time_or_null"
    },
    "updated_at": {
      "$ref": "#/$defs/source_time_or_null"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "language": {
      "type": [
        "string",
        "null"
      ]
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "description": "Extensible actor taxonomy: person, organization, institution, company, etc."
          },
          "external_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "country": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "default": []
    },
    "source_topics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "classifications": {
      "type": "array",
      "description": "Provider-native classifications such as CPC/IPC/OpenAlex topic IDs/tags.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scheme",
          "value"
        ],
        "properties": {
          "scheme": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "default": []
    },
    "metrics": {
      "type": "object",
      "description": "Provider metrics captured at observed_at. Values remain raw; cross-source normalization happens downstream.",
      "additionalProperties": {
        "type": [
          "number",
          "integer",
          "string",
          "boolean",
          "null"
        ]
      },
      "default": {}
    },
    "relationships": {
      "type": "array",
      "description": "Links used to collapse derivatives/families/mirrors. Relation names are extensible.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "target_id"
        ],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "target_id": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "default": []
    },
    "quality_flags": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "boolean",
          "string",
          "number",
          "null"
        ]
      },
      "default": {}
    },
    "fingerprints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "canonical_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "content_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "simhash": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "collection_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "technology_direction": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "query_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "matched_terms": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional access/reuse metadata. This is informational and not a legal determination.",
      "properties": {
        "license": {
          "type": [
            "string",
            "null"
          ]
        },
        "access_level": {
          "type": [
            "string",
            "null"
          ]
        },
        "reuse_notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "analysis": {
      "type": "object",
      "description": "Optional downstream fields; adapters must not invent them.",
      "additionalProperties": false,
      "properties": {
        "relevance": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "novelty": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "cluster_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "embedding_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "technology_labels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "raw_ref": {
      "type": [
        "string",
        "null"
      ],
      "description": "Pointer to temporary raw object, e.g. R2 key. Never store secrets."
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collector",
        "collector_version"
      ],
      "properties": {
        "collector": {
          "type": "string",
          "minLength": 1
        },
        "collector_version": {
          "type": "string",
          "minLength": 1
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_endpoint": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "$defs": {
    "source_time_or_null": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    }
  }
}